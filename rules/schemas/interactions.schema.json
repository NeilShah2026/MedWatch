{
  "$ref": "#/definitions/interactions",
  "definitions": {
    "interactions": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PLACEHOLDER_REQUIRES_CLINICAL_REVIEW", "CLINICIAN_APPROVED"]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "maxLength": 400
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z0-9_]+$"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "status": {
                "type": "string",
                "enum": ["PLACEHOLDER_REQUIRES_CLINICAL_REVIEW", "CLINICIAN_APPROVED"]
              },
              "description": {
                "type": "string",
                "minLength": 3,
                "maxLength": 400
              },
              "source_note": {
                "type": "string",
                "minLength": 3,
                "maxLength": 400
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "group_a": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "minItems": 1
              },
              "group_b": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "minItems": 1
              },
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 80
              },
              "risk_summary": {
                "type": "string",
                "minLength": 3,
                "maxLength": 400
              }
            },
            "required": [
              "id",
              "version",
              "status",
              "description",
              "source_note",
              "severity",
              "group_a",
              "group_b",
              "title",
              "risk_summary"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": ["status", "version", "description", "rules"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
