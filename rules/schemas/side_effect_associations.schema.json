{
  "$ref": "#/definitions/side_effect_associations",
  "definitions": {
    "side_effect_associations": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PLACEHOLDER_REQUIRES_CLINICAL_REVIEW", "CLINICIAN_APPROVED"]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "maxLength": 400
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z0-9_]+$"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "status": {
                "type": "string",
                "enum": ["PLACEHOLDER_REQUIRES_CLINICAL_REVIEW", "CLINICIAN_APPROVED"]
              },
              "description": {
                "type": "string",
                "minLength": 3,
                "maxLength": 400
              },
              "source_note": {
                "type": "string",
                "minLength": 3,
                "maxLength": 400
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "drug_class": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "symptoms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "symptom_code": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "typical_onset_days_min": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 365
                    },
                    "typical_onset_days_max": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 365
                    }
                  },
                  "required": ["symptom_code", "typical_onset_days_min", "typical_onset_days_max"],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "version",
              "status",
              "description",
              "source_note",
              "severity",
              "drug_class",
              "symptoms"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": ["status", "version", "description", "rules"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
