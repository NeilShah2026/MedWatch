{
  "name": "medwatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/core"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "env:write": "node scripts/write-env.mjs",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w packages/core && npm run typecheck -w apps/web && npm run typecheck:functions",
    "typecheck:functions": "node scripts/check-functions.mjs",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db:local": "bash scripts/local-pg/run.sh",
    "test:e2e": "npm run test:e2e -w apps/web",
    "db:link": "node scripts/supabase-link.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:reset": "tsx supabase/seed/cli.ts reset",
    "seed": "tsx supabase/seed/cli.ts seed",
    "functions:deploy": "node scripts/functions-deploy.mjs",
    "secrets:sync": "node scripts/secrets-sync.mjs",
    "rules:schemas": "tsx scripts/gen-rule-schemas.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "test:e2e:mock": "npm run test:e2e:mock -w apps/web",
    "mock:supabase": "tsx scripts/mock-supabase/server.ts --port 54399"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@vitest/coverage-v8": "3.2.7",
    "deno": "2.9.6",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "pg": "8.16.3",
    "prettier": "3.6.2",
    "supabase": "2.119.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "^6.4.4",
    "vitest": "3.2.7",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  }
}
