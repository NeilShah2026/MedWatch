# Frontend + scripts. Anything prefixed VITE_ ends up in the browser: public values only.
VITE_SUPABASE_URL=https://your-dev-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# development | staging | production (anything but production shows the demo banner)
VITE_APP_ENV=development

# Scripts only (never VITE_)
SUPABASE_DEV_PROJECT_REF=your-dev-project-ref
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_ENV=development
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_DB_PASSWORD=your-db-password
