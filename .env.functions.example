# Synced to Supabase Edge Function secrets with `npm run secrets:sync`.
AI_ENABLED=false
AI_PROVIDER=mock
AI_GATEWAY_URL=https://your-ai-gateway.example.com
AI_GATEWAY_API_KEY=your-gateway-key
AI_GATEWAY_AUTH_HEADER=x-api-key
AI_MODEL=claude-sonnet-5-5
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CRON_SECRET=generate-a-long-random-string
APP_ENV=development
# Public URL of the web app (used in invitation links)
APP_URL=http://localhost:5173
